# ==============================================================================
# FieldTrack Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` in relevant app directories before running.

# ------------------------------------------------------------------------------
# Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Hosted Supabase URL or local instance (default local: http://127.0.0.1:54321)
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for browser & mobile app clients)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose to browser/client code, server/edge functions only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Connection String (Direct Postgres connection for migrations & CLI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# Map Tile & Geolocation Services
# ------------------------------------------------------------------------------
# Default OpenStreetMap tile layer URL (or Mapbox / CartoDB / Stadia Maps endpoint)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional Mapbox Access Token (if using Mapbox GL or custom vector map layers)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSI...

# ------------------------------------------------------------------------------
# Edge Functions & Ingestion Service
# ------------------------------------------------------------------------------
# Ingestion API endpoint invoked by native mobile devices for batch GPS sync
NEXT_PUBLIC_INGESTION_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1/ingest-location

# ------------------------------------------------------------------------------
# Android Mobile App Build Config
# ------------------------------------------------------------------------------
# Variables injected into BuildConfig for apps/android
ANDROID_SUPABASE_URL=https://your-project-id.supabase.co
ANDROID_SUPABASE_ANON_KEY=your-anon-key
