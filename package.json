{
  "name": "fieldtrack",
  "version": "1.0.0",
  "private": true,
  "description": "FieldTrack Enterprise Monorepo — GPS Tracking & Employee Attendance Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@fieldtrack/admin-web",
    "build:web": "npm run build --workspace=@fieldtrack/admin-web",
    "start:web": "npm run start --workspace=@fieldtrack/admin-web",
    "lint:web": "npm run lint --workspace=@fieldtrack/admin-web",
    "typecheck:web": "npm run typecheck --workspace=@fieldtrack/admin-web",
    "test:web": "npm run test --workspace=@fieldtrack/admin-web"
  },
  "keywords": [
    "fieldtrack",
    "gps-tracking",
    "attendance",
    "enterprise",
    "monorepo"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
